{
  "name": "RStudio Codespace",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "overrideCommand": false,
  "forwardPorts": [8787],
  "portsAttributes": {
    "8787": {
      "label": "RStudio",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "sudo passwd -d rstudio || true",
  "remoteUser": "rstudio"
}
